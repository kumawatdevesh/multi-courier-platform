PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/courier

# --- UrbaneBolt -------------------------------------------------------------
COURIER_URBANEBOLT_ENABLED=true
COURIER_URBANEBOLT_BASE_URL=https://uat.urbanebolt.in
COURIER_URBANEBOLT_TIMEOUT_MS=15000
COURIER_URBANEBOLT_RETRY_ATTEMPTS=3
COURIER_URBANEBOLT_RETRY_BASE_DELAY_MS=250
COURIER_URBANEBOLT_USERNAME=
COURIER_URBANEBOLT_PASSWORD=
COURIER_URBANEBOLT_CUSTOMER_CODE=

# --- Mock ------------------------
COURIER_MOCK_ENABLED=true
COURIER_MOCK_BASE_URL=http://localhost:0
COURIER_MOCK_TIMEOUT_MS=1000
COURIER_MOCK_RETRY_ATTEMPTS=1
COURIER_MOCK_RETRY_BASE_DELAY_MS=50
COURIER_MOCK_FAILURE_RATE=0
