        {
          "name": "Create order (mock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "description": "Happy path. Stores `orderId` for the requests below.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"{{orderRef}}\",\n  \"courier_partner\": \"mock\",\n  \"payment_mode\": \"COD\",\n  \"cod_amount\": 499,\n  \"service_type\": \"SAME_DAY\",\n  \"pickup\": {\n    \"name\": \"Warehouse\",\n    \"phone\": \"9876543210\",\n    \"email\": \"ops@example.com\",\n    \"line1\": \"1 Industrial Rd\",\n    \"line2\": \"Sector 5\",\n    \"city\": \"Gurgaon\",\n    \"state\": \"Haryana\",\n    \"pincode\": \"122001\",\n    \"country\": \"INDIA\",\n    \"type\": \"SELLER\"\n  },\n  \"drop\": {\n    \"name\": \"Asha Rao\",\n    \"phone\": \"9876543211\",\n    \"email\": \"asha@example.com\",\n    \"line1\": \"12 MG Road\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"560001\",\n    \"country\": \"INDIA\",\n    \"type\": \"HOME\"\n  },\n  \"parcel\": {\n    \"description\": \"Books\",\n    \"weight_kg\": 1.2,\n    \"length_cm\": 30,\n    \"breadth_cm\": 20,\n    \"height_cm\": 10,\n    \"pieces\": 1,\n    \"declared_value\": 499\n  },\n  \"invoice\": {\n    \"number\": \"INV-2026-001\",\n    \"date\": \"2026-09-17\",\n    \"value\": 499\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('orderRef', 'PM-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('orderId', d.id);",
                  "pm.test('has awb', () => pm.expect(d.awb).to.be.a('string'));"
                ]
              }
            }
          ]
        },
