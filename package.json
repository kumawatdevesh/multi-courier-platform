{
  "name": "multi-courier-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Courier-agnostic shipment API with pluggable courier partners",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/db/data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/db/data-source.ts",
    "test": "vitest run",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/db/data-source.ts",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mts}\"",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "nock": "^13.5.6",
    "prettier": "^3.9.7",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
